# --- REQUIRED: where paid calls settle (USDC on Base) ---
# Configured default (set by owner 2026-10-06): his payout wallet on Base —
# the same payTo Token Verdict uses. Override per-environment with
# X402_PAY_TO if a different receiving wallet is wanted.
X402_PAY_TO=0x097f9685D1e0752bF8B02d61E5Ce9be7eA0FBA7F

# --- Pricing (USDC, dollars as string, e.g. "$0.05") ---
X402_PRICE_USDC=$0.05

# --- Network: Base mainnet (eip155:8453) earns REAL USDC. ---
X402_NETWORK=eip155:8453

# --- Facilitator: which index a settled payment catalogs this service in ---
# Cataloging is settlement-driven PER FACILITATOR. Default (unset) = the
# keyless ultravioletadao facilitator: settles Base, feeds no major index.
# PayAI (no keys needed): https://facilitator.payai.network -> PayAI index.
# CDP (needs the keys below): https://api.cdp.coinbase.com/platform/v2/x402
#   -> CDP Bazaar / Agentic.Market.
# X402_FACILITATOR_URL=https://facilitator.payai.network
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Service ---
X402_SERVICE_NAME=route-verdict
PORT=8000

# --- Checker ---
# Timeout (seconds) for probing a target endpoint.
ROUTE_VERDICT_FETCH_TIMEOUT_S=10
# sqlite file holding prior checks (the diff memory). On Railway, point
# this at the mounted volume path so diffs survive deploys.
ROUTE_VERDICT_DB=route-verdict.db
